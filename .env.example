# Meta WhatsApp Cloud API Credentials
# Copy this file to .env and fill in your values

APP_ID=your_app_id
PHONE_NUMBER_ID=your_phone_number_id
WABA_ID=your_waba_id
APP_SECRET=your_app_secret
ACCESS_TOKEN=your_meta_access_token

# Webhook verification token (set the same in Meta dashboard)
WEBHOOK_VERIFY_TOKEN=my_secure_verify_token_123

# Port the bot server listens on
PORT=3000

# Public tunnel URL (ngrok / cloudflare tunnel URL)
PUBLIC_URL=https://your-tunnel-url.trycloudflare.com

# Admin panel port
ADMIN_PORT=4000
